{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": false,
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": ["./**/*.ts", "../src/data/menuData.ts", "../src/types.ts"],
  "exclude": ["node_modules"]
}
